#!/usr/bin/env python3
"""The board popup: every herdr project at a glance, five columns, live, keyboard and mouse.

  board                  draw the board (the plugin's popup pane runs this)
  board --open           ask herdr to open the popup (the plugin's action runs this)
  board --once [SLUG]    print the board as plain text and exit (all projects, or one)
"""
import curses
import json
import os
import queue
import shutil
import subprocess
import sys
import threading
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
import board  # noqa: E402
import theme  # noqa: E402

